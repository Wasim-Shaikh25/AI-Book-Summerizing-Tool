# ============================================================
# Production environment overrides — copy to `.env` on the server.
# Only the keys that DIFFER from .env.example for a hardened deploy
# are listed here. Start from .env.example, then apply these.
# Never commit the real `.env`.
# ============================================================

# ----------------------------
# LLM provider (required for rewrite/structure quality)
# ----------------------------
LLM_PROVIDER=OPENAI
OPENAI_API_KEY=__set_real_key__
OPENAI_MODEL=gpt-4o-mini

# ----------------------------
# Web platform / security
# ----------------------------
# Enable real OAuth in production; keep guest access optional.
AUTH_ENABLED=true
ALLOW_GUEST=true

# MUST be a long random secret in prod (e.g. `openssl rand -hex 32`).
JWT_SECRET=__set_long_random_secret__
JWT_EXPIRE_DAYS=7

# Public URLs as seen by the browser (used for CORS + OAuth redirects).
FRONTEND_URL=https://notes.example.com
API_BASE_URL=https://notes.example.com
# When the frontend is served same-origin via nginx, no extra origins needed.
# Add any additional allowed origins here, comma-separated.
CORS_EXTRA_ORIGINS=

# Uvicorn workers (tune to CPU; 2 is a safe default for small instances).
UVICORN_WORKERS=2

# Upload + rate limits (tighten for public exposure).
MAX_UPLOAD_MB=100
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------
# OAuth providers (set the ones you use; redirects must be public HTTPS)
# ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://notes.example.com/api/auth/google/callback

# ----------------------------
# Pipeline cost/quality knobs (prod defaults)
# ----------------------------
INGESTION_PROFILE=quality_cloud
NOTES_QUALITY_AUDIT=1
