logs/
output/
tmp/
pdfs/
backend/logs/
backend/output/

# SQLite journals
*.db-journal
*.db-wal
*.db-shm

# Local LLM model weights (download separately)
models/*.gguf
models/*.tmp
models/*.bin

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
*.swo
