venv/
env/

# Runtime data — mounted as volumes at runtime, not baked
output/
logs/
models/
*.db
*.sqlite

# Local model / HF caches
.cache/
.huggingface/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
