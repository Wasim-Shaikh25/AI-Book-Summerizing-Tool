# ============================
# AI Book Summarizing Tool - Environment Example
# Copy this file to `.env` and fill only what you need.
# ============================
#
# IMPORTANT RULE (how config is resolved)
# 1) The app reads `LLM_*` variables first (generic, works for ALL providers).
# 2) If you set provider-specific variables (OPENAI_* / GEMINI_* / OLLAMA_*),
#    those will OVERRIDE the generic LLM_* values.
#
# Goal:
# - Keep `.env` small: set the provider + the minimal required keys.
# - Only add provider-specific overrides when you want custom behavior.
#

# ----------------------------
# Choose provider
# ----------------------------
# One of: OLLAMA | GEMINI | OPENAI
LLM_PROVIDER=OLLAMA

# ----------------------------
# Generic LLM_* (works for ALL providers)
# ----------------------------
# Use these as your default configuration.
# Provider-specific values (below) override these if set.
#
# Model name:
# - Ollama examples: llama3.2:3b, qwen2.5:7b
# - OpenAI examples: gpt-4o-mini
# - Gemini examples: models/gemini-3.1-flash-lite-preview (or gemini-1.5-flash; both are accepted)
LLM_MODEL=

# Base URL:
# - Ollama: http://localhost:11434
# - OpenAI: https://api.openai.com (or your proxy/gateway)
# - Gemini: usually not required (leave empty)
LLM_BASE_URL=

# Timeout for network calls (seconds)
LLM_TIMEOUT_S=600

# Debug (prints request/response snippets to terminal)
LLM_HTTP_DEBUG=0
LLM_HTTP_DEBUG_MAX_CHARS=4000

# ----------------------------
# Pipeline batch sizing (applies to ALL providers)
# ----------------------------
# Default is 20; lower this if your model is slow / hitting timeouts.
LLM_VALIDITY_BATCH_SIZE=20
LLM_TOC_BATCH_SIZE=20

# ============================================================
# Provider-specific overrides (OPTIONAL)
# Only set these if you want to override the generic LLM_*.
# ============================================================

# ----------------------------
# Gemini (Google GenAI)
# ----------------------------
# REQUIRED if LLM_PROVIDER=GEMINI:
# - GEMINI_API_KEY (or GOOGLE_API_KEY)
GEMINI_API_KEY=
# Optional overrides of LLM_MODEL / LLM_TIMEOUT_S (leave empty to use LLM_*)
GEMINI_MODEL=
GEMINI_TIMEOUT_S=

# ----------------------------
# OpenAI
# ----------------------------
# REQUIRED if LLM_PROVIDER=OPENAI:
OPENAI_API_KEY=
# Optional override of LLM_MODEL / LLM_BASE_URL / LLM_TIMEOUT_S
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_S=

# ----------------------------
# Ollama (local)
# ----------------------------
# Optional override of LLM_MODEL / LLM_BASE_URL / LLM_TIMEOUT_S
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=

# Ollama-only tuning knobs (Ollama supports these; other providers don't)
OLLAMA_NUM_PREDICT=96
