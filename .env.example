# ============================
# AI Notes Creator Model — Environment Example
# Copy to `.env` and fill secrets. Never commit `.env`.
# Overlay: default.yaml → system env → .env
# ============================

# ----------------------------
# Project paths
# ----------------------------
PROJECT_ROOT=

# ----------------------------
# Master LLM provider
# One of: OPENAI | OPENROUTER
# ----------------------------
LLM_PROVIDER=OPENROUTER

# ----------------------------
# Generic LLM defaults (LLM_*)
# ----------------------------
LLM_BASE_URL=
LLM_MODEL=openrouter/free
LLM_TIMEOUT_S=600
LLM_HTTP_DEBUG=0
LLM_VALIDITY_BATCH_SIZE=20
LLM_TOC_BATCH_SIZE=20

# ----------------------------
# OpenAI
# ----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_S=

# ----------------------------
# OpenRouter — https://openrouter.ai/settings/keys
# Free router: https://openrouter.ai/openrouter/free
# ----------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_S=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=AI Notes Creator

# ----------------------------
# Google Gemini (optional)
# ----------------------------
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
GEMINI_TIMEOUT_S=

# ----------------------------
# Intent routing & prompt refinement
# ----------------------------
USE_LLM_INTENT=1
INTENT_REFINER_BACKEND=

# ----------------------------
# Stage 15b — doubted section resolver
# ----------------------------
DOUBTED_RESOLVER_MODE=revalidate_selected
DOUBTED_RESOLVER_LLM=
DOUBTED_REVALIDATION_MODEL=
DOUBTED_REVALIDATION_CONFIDENCE=0.85
DOUBTED_REVALIDATION_MAX=40

# ----------------------------
# Stage 15e — chapter hierarchy
# ----------------------------
CHAPTER_HIERARCHY_USE_LLM=true
CHAPTER_HIERARCHY_LLM=
CHAPTER_HIERARCHY_BATCH_SIZE=25
CHAPTER_HIERARCHY_MAX_SECTIONS=0
CHAPTER_HIERARCHY_MIN_SECTIONS_PER_CHAPTER=6

# ----------------------------
# Stage 15f — heading cleanup
# Backend: rules_only | minilm | openai | openrouter
# ----------------------------
HEADING_CLEANUP_BACKEND=openai
HEADING_CLEANUP_USE_LLM=true
HEADING_CLEANUP_LLM=
HEADING_CLEANUP_BATCH_SIZE=20
HEADING_CLEANUP_MINILM_PICK_THRESHOLD=0.82

# ----------------------------
# Stage 15g / s13 — title validation (rules only)
# ----------------------------
TITLE_VALIDATION_ENABLED=true

# ----------------------------
# Stage 15h — chapter placement
# ----------------------------
CHAPTER_PLACEMENT_ENABLED=true
CHAPTER_PLACEMENT_REASSIGN=true
CHAPTER_PLACEMENT_RENAME_CHAPTERS=true
CHAPTER_PLACEMENT_MIN_SECTIONS_FOR_RENAME=3
CHAPTER_PLACEMENT_COHESION_THRESHOLD=0.58
CHAPTER_PLACEMENT_REASSIGN_MARGIN=0.06
CHAPTER_PLACEMENT_PAGE_MARGIN=8
CHAPTER_PLACEMENT_MAX_SECTIONS_PER_CHAPTER=12
CHAPTER_PLACEMENT_PAGE_GAP_SPLIT=16
CHAPTER_PLACEMENT_MIN_SECTIONS_PER_CHAPTER=3
CHAPTER_PLACEMENT_MIN_CHAPTER_CHARS=400

# ----------------------------
# Stage 15i — heading refinement
# ----------------------------
HEADING_REFINEMENT_ENABLED=true
HEADING_REFINEMENT_USE_TRANSFORMERS=true
HEADING_REFINEMENT_DEDUPE=true
HEADING_REFINEMENT_DROP_EMPTY=true
HEADING_REFINEMENT_MINILM_THRESHOLD=0.8
HEADING_REFINEMENT_OPENAI_FALLBACK=false

# ----------------------------
# Stage 15j — cloud hierarchy regroup + title polish
# ----------------------------
HIERARCHY_OPENAI_ENABLED=true
HIERARCHY_OPENAI_PROVIDER=
HIERARCHY_OPENAI_TARGET_MAX_CHAPTERS=8
HIERARCHY_OPENAI_MIN_SECTIONS_PER_CHAPTER=3
HIERARCHY_OPENAI_MIN_CHAPTER_CHARS=400
HIERARCHY_OPENAI_REGROUP_BATCH_SIZE=22

# ----------------------------
# Chapter cohesion
# ----------------------------
CHAPTER_COHESION_MIN_SECTIONS=3
CHAPTER_COHESION_MIN_CHARS=400
CHAPTER_COHESION_MAX_SECTIONS=12
CHAPTER_COHESION_THRESHOLD=0.52

# ----------------------------
# Ingestion profile
# fast_local | quality_cloud | debug
# ----------------------------
INGESTION_PROFILE=quality_cloud
UPLOAD_SKIP_RAG=false

# ----------------------------
# Full-book rewrite
# Leave REWRITE_PROVIDER_ORDER empty to use LLM_PROVIDER only.
# ----------------------------
REWRITE_PROVIDER_ORDER=
REWRITE_MAX_TOKENS=15000
REWRITE_USER_INSTRUCTION=short easy notes, do not add extra details
REWRITE_PARALLEL_WORKERS=8
REWRITE_CONTEXT_OVERLAP_CHARS=600
REWRITE_AUTO_RETRY_MISSING=1
REWRITE_MISSING_MAX_ROUNDS=3
REWRITE_REQUIRE_FULL_COVERAGE=1
REWRITE_SECTION_MAX_TOKENS=
REWRITE_BUNDLE_SIZE=1
REWRITE_BUNDLE_MAX_CHARS=12000
REWRITE_BUNDLE_EXPORT=true
REWRITE_CHAPTER_PAGE_BREAKS=auto
COMPACT_EXAM=0
EXPORT_DOCX=1
EXPORT_APPEND_SUBTOPIC_CHECKLIST=false
DOCX_THEME=color
# Universal academic typography (Word export + LLM format spec)
DOCX_FONT_FAMILY=Times New Roman
DOCX_BODY_SIZE_PT=11
DOCX_H1_SIZE_PT=20
DOCX_H2_SIZE_PT=16
DOCX_H3_SIZE_PT=13
DOCX_LINE_SPACING=1.2
DOCX_FIRST_LINE_INDENT=1
DOCX_FIRST_LINE_INDENT_IN=0.3
# book = prose textbook layout | study = bullets + subtopic labels
NOTES_EXPORT_STYLE=book

# ----------------------------
# Notes quality audit (post-pipeline)
# ----------------------------
NOTES_QUALITY_AUDIT=1
NOTES_QUALITY_LLM=1
NOTES_QUALITY_LLM_PROVIDER=
# Line-by-line body audit (meta filler, thin bullets, drift, heading echo)
NOTES_QUALITY_LINE_AUDIT=1
# Stricter per-line checks (punctuation, overlap)
NOTES_QUALITY_LINE_AUDIT_STRICT=0

# ----------------------------
# Pipeline run controls
# ----------------------------
PIPELINE_PDF=
PIPELINE_MAX_PAGES=0
FULL_REWRITE_MAX_CHUNKS=0
SKIP_STRUCTURE=0
PIPELINE_LOG_DIR=

# ----------------------------
# Stage 15d — section sizing
# ----------------------------
ULTIMATE_PROFILE=auto
ULTIMATE_MIN_PARENT_FRAGMENT_CHARS=
ULTIMATE_MIN_SECTION_CHARS_FOR_NESTING=
ULTIMATE_MIN_HEADING_FRAGMENT_CHARS=
ULTIMATE_MAX_REWRITE_SECTION_CHARS=

# ----------------------------
# Chunking & debug
# ----------------------------
CHUNK_SIZE_WORDS=1500
CHUNK_OVERLAP_WORDS=150
DEBUG_STRUCTURE=true
ENGLISH_ONLY=true

# ----------------------------
# Vector RAG
# ----------------------------
RAG_ENABLED=1
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_INDEX_DIR=output/rag_index
RAG_TOP_K=6
RAG_VECTOR_WEIGHT=0.65
RAG_LEXICAL_WEIGHT=0.35
RAG_MIN_SCORE=0.15
RAG_CHUNK_SIZE_WORDS=0
RAG_CHUNK_OVERLAP_WORDS=80
RAG_MIN_CHUNK_CHARS=40
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_RERANK_CANDIDATES=50
RAG_CONTEXT_MAX_CHARS=12000

# ----------------------------
# Page OCR
# ----------------------------
OCR_ENABLED=1
OCR_MODE=auto
OCR_SPLIT_TWO_UP=0
OCR_MIN_TEXT_CHARS=40
OCR_ZOOM=2.0
OCR_LANG=eng
TESSERACT_CMD=

# ============================================================
# Web platform
# ============================================================
AUTH_ENABLED=false
# Allow anonymous "Continue as guest" access even when AUTH_ENABLED=true.
# Each guest gets an isolated, persisted guest account + short-lived session token.
ALLOW_GUEST=true
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed by CORS (prod domains behind a proxy).
CORS_EXTRA_ORIGINS=
# Uvicorn worker processes (prod). Keep 1 for dev/reload.
UVICORN_WORKERS=1
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7
CHAT_DOCX_CHAR_LIMIT=4000
MAX_UPLOAD_MB=100
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REDIRECT_URI=http://localhost:8000/api/auth/apple/callback

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/facebook/callback
