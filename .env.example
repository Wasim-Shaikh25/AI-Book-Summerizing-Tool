# ============================
# AI Book Summarizing Tool - Environment Example
# Copy this file to `.env` and adjust values as needed.
# ============================
#
# How configuration works (important)
# - Generic `LLM_*` keys are the common defaults (used by ALL providers).
# - Provider-specific keys override the generic ones when set:
#   - GEMINI_* overrides LLM_* when LLM_PROVIDER=GEMINI
#   - OPENAI_* overrides LLM_* when LLM_PROVIDER=OPENAI
#   - OLLAMA_* overrides LLM_* when LLM_PROVIDER=OLLAMA
#
# Tip for testing:
# - Keep all provider blocks filled so you can switch `LLM_PROVIDER`
#   without re-editing the file too much.

# ----------------------------
# Choose provider
# ----------------------------
# One of: LLAMACPP | OLLAMA | GEMINI | OPENAI
LLM_PROVIDER=LLAMACPP

# ----------------------------
# Generic defaults (LLM_*)
# ----------------------------
# Keep these as your baseline. We set “Gemini-friendly” defaults here.
# Base URL:
# - Gemini: leave empty (not used)
# - Ollama: http://localhost:11434
# - OpenAI: https://api.openai.com (or your proxy/gateway)
LLM_BASE_URL=

# Model:
# - Gemini examples: models/gemini-3.1-flash-lite-preview, gemini-1.5-flash
# - OpenAI examples: gpt-4o-mini
# - Ollama examples: llama3.2:3b, qwen2.5:7b
LLM_MODEL=models/gemini-3.1-flash-lite-preview

# Network timeout (seconds)
LLM_TIMEOUT_S=600

# Debug request/response snippets (0 = off, 1 = on)
LLM_HTTP_DEBUG=0

# Pipeline batch sizing (applies to ALL providers)
LLM_VALIDITY_BATCH_SIZE=20
LLM_TOC_BATCH_SIZE=20

# ============================================================
# Provider-specific settings / overrides
# Fill these so switching provider is easy during testing.
# ============================================================

# ----------------------------
# Gemini (Google GenAI)
# ----------------------------
# Required if LLM_PROVIDER=GEMINI:
GEMINI_API_KEY=
# Optional overrides (leave empty to use LLM_*)
GEMINI_MODEL=
GEMINI_TIMEOUT_S=

# ----------------------------
# OpenAI
# ----------------------------
# Required for OpenAI / ChatGPT API (platform.openai.com — separate from ChatGPT Plus UI):
OPENAI_API_KEY=
# Optional overrides (leave empty to use LLM_*)
# Examples: gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TIMEOUT_S=

# ----------------------------
# Ollama (local)
# ----------------------------
# Optional overrides (leave empty to use LLM_*)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=

# ----------------------------
# Stage 15b — doubted section resolver (fast + selective revalidation)
# ----------------------------
# fast = rules + MiniLM only (no LLM)
# revalidate_selected = fast pass, then LLM audits only flagged segments (recommended)
DOUBTED_RESOLVER_MODE=revalidate_selected

# LLM backend: off | ollama | llamacpp | bigbird
# Prefer direct llama.cpp for speed.
DOUBTED_RESOLVER_LLM=llamacpp

# Optional model tag for Ollama backend only
DOUBTED_REVALIDATION_MODEL=qwen2.5:0.5b-instruct
DOUBTED_REVALIDATION_CONFIDENCE=0.85
DOUBTED_REVALIDATION_MAX=40

# Required for llamacpp backend (pick a <=0.5B GGUF for speed)
# LLAMACPP_MODEL_PATH=C:/models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf
# LLAMACPP_N_CTX=2048
# LLAMACPP_N_GPU_LAYERS=0

# ----------------------------
# Full-book rewrite (RAG chat / sequential rewrite)
# ----------------------------
# Prefer Qwen2.5 3B Instruct Q4_K_M for better note quality on CPU:
# Put the GGUF under <project>/models/ or set an absolute path below.
# If unset, the app looks for models/Qwen2.5-3B-Instruct-Q4_K_M.gguf first,
# then 1.5B, then tries auto-download (large file ~2GB — allow time/network).
#
# Provider order for rewrite / RAG answer generation (comma-separated):
#   llamacpp — local GGUF, openai|chatgpt — OpenAI API, gemini — Google Gemini
# API-only (skip local models): openai,gemini
REWRITE_PROVIDER_ORDER=openai,gemini
REWRITE_LLAMACPP_MODEL_PATH=
# Override download URLs if needed:
# REWRITE_LLAMACPP_MODEL_URLS=https://...

# Dynamic mini-prompt before each rewrite chunk (recommended on)

# ----------------------------
# Chunking / pipeline debug
# ----------------------------
CHUNK_SIZE_WORDS=1500
CHUNK_OVERLAP_WORDS=150
DEBUG_STRUCTURE=true
PIPELINE_MAX_PAGES=0
FULL_REWRITE_MAX_CHUNKS=0

# Stage 15d — section sizing (auto picks from REWRITE_PROVIDER_ORDER)
# Profile: auto | large (openai/gemini) | medium | small (llamacpp)
# ULTIMATE_PROFILE=auto
# ULTIMATE_MIN_PARENT_FRAGMENT_CHARS=900
# ULTIMATE_MIN_SECTION_CHARS_FOR_NESTING=600
# ULTIMATE_MIN_HEADING_FRAGMENT_CHARS=220
# ULTIMATE_MAX_REWRITE_SECTION_CHARS=6000

# ----------------------------
# llama.cpp (local GGUF)
# ----------------------------
LLAMACPP_MODEL_PATH=
LLAMACPP_N_CTX=2048
LLAMACPP_N_GPU_LAYERS=0
REWRITE_MAX_TOKENS=15000
