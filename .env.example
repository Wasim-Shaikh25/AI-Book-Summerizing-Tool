# ----------------------------
# LLM Provider Selection
# ----------------------------
# Choose one: OLLAMA | GEMINI | OPENAI
LLM_PROVIDER=OLLAMA

# Back-compat (older name). Prefer LLM_PROVIDER.
ACTIVE_MODEL=OLLAMA

# ----------------------------
# Pipeline batch sizing (applies to ALL providers)
# ----------------------------
# Default is 20; lower this if your local model is slow.
LLM_VALIDITY_BATCH_SIZE=20
LLM_TOC_BATCH_SIZE=20

# ----------------------------
# Gemini (Google GenAI)
# ----------------------------
# GEMINI_API_KEY also accepts GOOGLE_API_KEY (see src/config.py)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.1-flash-lite-preview

# ----------------------------
# OpenAI
# ----------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# ----------------------------
# Ollama (local)
# ----------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=600
OLLAMA_NUM_PREDICT=96
OLLAMA_HTTP_DEBUG=0
OLLAMA_HTTP_DEBUG_MAX_CHARS=4000
